{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "application",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/plantcare-icon.svg",
          "/*.css",
          "/*.js"
        ]
      }
    }
  ],
  "navigationRequestStrategy": "freshness"
}
