{
  "services": {
    "database": {
      "mem_limit": "2g",
      "memswap_limit": "2g",
      "environment": { "MSSQL_MEMORY_LIMIT_MB": "1024" }
    },
    "api": { "mem_limit": "384m", "memswap_limit": "384m" },
    "worker": { "mem_limit": "192m", "memswap_limit": "192m" },
    "proxy": { "mem_limit": "128m", "memswap_limit": "128m" }
  }
}
