# Public DNS name pointing to this server. Do not include https://.
PLANTCARE_DOMAIN=plants.example.com

# Use a long, randomly generated password.
SQL_PASSWORD=replace-with-a-strong-database-password

# SMTP provider settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_ADDRESS=plantcare@example.com
SMTP_FROM_NAME=PlantCare

# Use the VAPID values created for browser push notifications.
WEB_PUSH_SUBJECT=mailto:admin@example.com
WEB_PUSH_PUBLIC_KEY=replace-with-public-vapid-key
WEB_PUSH_PRIVATE_KEY=replace-with-private-vapid-key

# Optional Google Calendar synchronization. Create an OAuth Web application
# whose redirect URI is https://your-domain/api/calendar/integrations/google/callback.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Optional Outlook and Microsoft 365 synchronization. Register a Web redirect
# URI ending in /api/calendar/integrations/microsoft/callback.
MICROSOFT_CALENDAR_ENABLED=false
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common

# Optional worker tuning.
NOTIFICATION_POLL_SECONDS=60
NOTIFICATION_BATCH_SIZE=100
